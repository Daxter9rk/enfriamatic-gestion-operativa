rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn()
        && profile().status == 'active'
        && profile().role in ['admin', 'operator'];
    }

    function admin() {
      return active() && profile().role == 'admin';
    }

    function ownsRequest(data) {
      return data.createdBy == request.auth.uid || data.assigneeId == request.auth.uid;
    }

    function supervisesRequest(data) {
      return data.supervisorId == request.auth.uid;
    }

    function canReadRequest(data) {
      return admin() || ownsRequest(data) || supervisesRequest(data);
    }

    function canReadQuote(data) {
      return admin()
        || data.createdBy == request.auth.uid
        || data.supervisorId == request.auth.uid;
    }

    function editableQuote(quoteId) {
      let quote = get(/databases/$(database)/documents/quotes/$(quoteId)).data;
      return quote.status == 'draft'
        && quote.locked == false
        && (admin() || quote.createdBy == request.auth.uid);
    }

    function validQuoteItem(data) {
      return data.description is string
        && data.description.size() > 0
        && data.description.size() <= 500
        && data.unit is string
        && data.unit.size() > 0
        && data.quantity is number
        && data.quantity > 0
        && data.originalUnitPrice is number
        && data.originalUnitPrice >= 0
        && data.discountPercent is number
        && data.discountPercent >= 0
        && data.discountPercent <= 100
        && data.taxRate is number
        && data.taxRate >= 0
        && data.taxRate <= 1
        && data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if active() && (
        admin()
        || userId == request.auth.uid
        || resource.data.supervisorId == request.auth.uid
      );
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if active() && (admin() || profile().teamId == teamId);
      allow write: if false;
    }

    match /clients/{clientId} {
      allow read: if active();
      allow write: if false;
    }

    match /sites/{siteId} {
      allow read: if active();
      allow write: if false;
    }

    match /equipment/{equipmentId} {
      allow read: if active();
      allow write: if false;
    }

    match /requests/{requestId} {
      allow read: if active() && canReadRequest(resource.data);
      allow write: if false;
    }

    match /catalogItems/{itemId} {
      allow read: if active();
      allow write: if false;
    }

    match /quotes/{quoteId} {
      allow read: if active() && canReadQuote(resource.data);
      allow create, delete: if false;
      allow update: if active()
        && resource.data.status == 'draft'
        && resource.data.locked == false
        && request.resource.data.status == 'draft'
        && request.resource.data.locked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'discountDisplayMode',
          'validityDays',
          'notes',
          'conditions',
          'totals',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && (admin() || resource.data.createdBy == request.auth.uid);

      match /items/{itemId} {
        allow read: if active() && canReadQuote(
          get(/databases/$(database)/documents/quotes/$(quoteId)).data
        );
        allow create: if active() && editableQuote(quoteId) && validQuoteItem(request.resource.data);
        allow update: if active()
          && editableQuote(quoteId)
          && validQuoteItem(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if active() && editableQuote(quoteId);
      }
    }

    match /notifications/{notificationId} {
      allow read: if active() && resource.data.userId == request.auth.uid;
      allow update: if active()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if active() && (
        admin()
        || resource.data.actorId == request.auth.uid
        || resource.data.actorSupervisorId == request.auth.uid
      );
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if active();
      allow write: if false;
    }

    match /manuals/{manualId} {
      allow read: if active() && (
        admin()
        || resource.data.accessScope == 'all_active'
      );
      allow write: if false;
    }

    match /documents/{documentId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /idempotencyKeys/{operationId} {
      allow read, write: if false;
    }

    match /consistencyJobs/{jobId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
